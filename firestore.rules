rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function bootstrapExists() {
      return exists(/databases/$(database)/documents/system/bootstrap);
    }

    function bootstrap() {
      return get(/databases/$(database)/documents/system/bootstrap).data;
    }

    function isBootstrapOwner() {
      return signedIn()
        && bootstrapExists()
        && bootstrap().initialized == false
        && request.auth.token.email != null
        && request.auth.token.email == bootstrap().ownerEmail;
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/accessProfiles/$(uid()));
    }

    function profile() {
      return get(/databases/$(database)/documents/accessProfiles/$(uid())).data;
    }

    function activeAccount() {
      return profileExists()
        && profile().active == true;
    }

    function ownershipExists() {
      return exists(/databases/$(database)/documents/system/ownership);
    }

    function ownership() {
      return get(/databases/$(database)/documents/system/ownership).data;
    }

    function isSystemOwner() {
      return activeAccount()
        && ownershipExists()
        && ownership().primaryOwnerUid == uid()
        && profile().isSystemOwner == true
        && profile().protectedPrincipal == true
        && profile().clearanceLevel == 10;
    }

    function temporaryAccessExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/temporaryAccess/$(uid()));
    }

    function temporaryAccess() {
      return get(/databases/$(database)/documents/temporaryAccess/$(uid())).data;
    }

    function temporaryAccessActive() {
      return temporaryAccessExists()
        && temporaryAccess().active == true
        && temporaryAccess().expiresAt is timestamp
        && request.time < temporaryAccess().expiresAt;
    }

    function hasPermanentPermission(permission) {
      return activeAccount()
        && (
          isSystemOwner()
          || (
            profile().permissions is list
            && profile().permissions.hasAny([permission])
          )
        );
    }

    function hasPermission(permission) {
      return activeAccount()
        && (
          isSystemOwner()
          || (
            profile().permissions is list
            && profile().permissions.hasAny([permission])
          )
          || (
            temporaryAccessActive()
            && temporaryAccess().permissions is list
            && temporaryAccess().permissions.hasAny([permission])
          )
        );
    }

    function containsReservedPermission(data) {
      return data.permissions is list
        && data.permissions.hasAny([
          "system.manage",
          "access.manage",
          "access.temporary.manage",
          "security.manage",
          "employee.manage",
          "organization.manage",
          "admin.organization.manage"
        ]);
    }

    function safeNonOwnerProfile(data) {
      return data.isSystemOwner != true
        && data.protectedPrincipal != true
        && data.clearanceLevel is int
        && data.clearanceLevel >= 0
        && data.clearanceLevel <= 9
        && data.active is bool
        && data.permissions is list
        && data.roles is list
        && !data.roles.hasAny(["SYSTEM_OWNER"]);
    }

    function safeDelegatedProfile(data) {
      return safeNonOwnerProfile(data)
        && !containsReservedPermission(data);
    }

    function protectedOwnerProfile(data) {
      return data.isSystemOwner == true
        && data.protectedPrincipal == true
        && data.clearanceLevel == 10
        && data.active == true
        && data.roles is list
        && data.roles.hasAny(["SYSTEM_OWNER"]);
    }

    function clearanceAtLeast(level) {
      return activeAccount()
        && (
          profile().clearanceLevel >= level
          || (
            temporaryAccessActive()
            && temporaryAccess().clearanceLevel >= level
          )
        );
    }

    function classificationLevel(classification) {
      return classification == "STANDARD" ? 0
        : classification == "INTERNAL" ? 1
        : classification == "CONFIDENTIAL" ? 2
        : classification == "SENSITIVE" ? 4
        : classification == "RESTRICTED" ? 6
        : classification == "HIGHLY_RESTRICTED" ? 8
        : 10;
    }

    function classificationAllowed(classification) {
      return clearanceAtLeast(classificationLevel(classification));
    }

    function classifiedRecordAllowed(data) {
      return activeAccount()
        && data.minimumClearance is int
        && clearanceAtLeast(data.minimumClearance);
    }

    function validClassification(data) {
      return data.minimumClearance is int
        && data.minimumClearance == classificationLevel(data.classification);
    }

    function canReadCustomerRelated(customerRecordId) {
      return hasPermission("customer.view")
        && exists(/databases/$(database)/documents/customers/$(customerRecordId))
        && (
          isSystemOwner()
          || classifiedRecordAllowed(
            get(/databases/$(database)/documents/customers/$(customerRecordId)).data
          )
        );
    }

    function canEditCustomerRelated(customerRecordId) {
      return hasPermission("customer.edit")
        && canReadCustomerRelated(customerRecordId);
    }

    match /system/bootstrap {
      allow read: if signedIn();

      allow update: if isBootstrapOwner()
        && resource.data.initialized == false
        && request.resource.data.initialized == true
        && request.resource.data.ownerEmail == resource.data.ownerEmail;

      allow create, delete: if false;
    }

    match /system/ownership {
      allow read: if isSystemOwner() || isBootstrapOwner();

      allow create: if isBootstrapOwner()
        && request.resource.data.primaryOwnerUid == uid();

      allow update: if isSystemOwner()
        && request.resource.data.primaryOwnerUid == resource.data.primaryOwnerUid;

      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (userId == uid() || hasPermanentPermission("employee.manage"));

      allow create: if (
          isBootstrapOwner()
          && userId == uid()
          && request.resource.data.protectedPrincipal == true
          && request.resource.data.ownerStatus == "primary"
        )
        || (
          hasPermanentPermission("employee.manage")
          && request.resource.data.protectedPrincipal != true
          && request.resource.data.ownerStatus != "primary"
        );

      allow update: if (
          resource.data.protectedPrincipal == true
          && isSystemOwner()
          && userId == uid()
          && request.resource.data.protectedPrincipal == true
          && request.resource.data.ownerStatus == "primary"
          && request.resource.data.accountStatus == "active"
        )
        || (
          resource.data.protectedPrincipal != true
          && hasPermanentPermission("employee.manage")
          && request.resource.data.protectedPrincipal != true
          && request.resource.data.ownerStatus != "primary"
        );

      allow delete: if false;
    }

    match /accessProfiles/{userId} {
      allow read: if signedIn()
        && (userId == uid() || hasPermanentPermission("access.manage"));

      allow create: if (
          isBootstrapOwner()
          && userId == uid()
          && protectedOwnerProfile(request.resource.data)
        )
        || (
          hasPermanentPermission("access.manage")
          && safeNonOwnerProfile(request.resource.data)
          && (
            isSystemOwner()
            || safeDelegatedProfile(request.resource.data)
          )
        );

      allow update: if (
          resource.data.protectedPrincipal == true
          && isSystemOwner()
          && userId == uid()
          && protectedOwnerProfile(request.resource.data)
        )
        || (
          resource.data.protectedPrincipal != true
          && hasPermanentPermission("access.manage")
          && safeNonOwnerProfile(request.resource.data)
          && (
            isSystemOwner()
            || safeDelegatedProfile(request.resource.data)
          )
        );

      allow delete: if false;
    }

    match /employees/{employeeRecordId} {
      allow read: if signedIn()
        && (
          employeeRecordId == uid()
          || hasPermission("employee.view")
          || hasPermanentPermission("employee.manage")
        );

      allow create: if (
          isBootstrapOwner()
          && employeeRecordId == uid()
          && request.resource.data.employeeId == "EMP-000001"
          && request.resource.data.clearanceLevel == 10
          && request.resource.data.accountClass == "protected_principal"
        )
        || (
          hasPermanentPermission("employee.manage")
          && request.resource.data.accountClass != "protected_principal"
          && request.resource.data.clearanceLevel is int
          && request.resource.data.clearanceLevel >= 0
          && request.resource.data.clearanceLevel <= 9
        );

      allow update: if (
          resource.data.accountClass == "protected_principal"
          && isSystemOwner()
          && employeeRecordId == uid()
          && request.resource.data.accountClass == "protected_principal"
          && request.resource.data.clearanceLevel == 10
          && request.resource.data.employmentStatus == "active"
        )
        || (
          resource.data.accountClass != "protected_principal"
          && hasPermanentPermission("employee.manage")
          && request.resource.data.accountClass != "protected_principal"
          && request.resource.data.clearanceLevel is int
          && request.resource.data.clearanceLevel >= 0
          && request.resource.data.clearanceLevel <= 9
        );

      allow delete: if false;
    }

    match /registrationRequests/{userId} {
      allow read: if signedIn()
        && (userId == uid() || hasPermission("system.manage"));

      allow create: if signedIn()
        && userId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.status == "pending";

      allow update: if hasPermission("system.manage");
      allow delete: if false;
    }

    match /customers/{customerRecordId} {
      allow read: if isSystemOwner()
        || (
          hasPermission("customer.view")
          && classifiedRecordAllowed(resource.data)
        );

      allow create: if hasPermission("customer.create")
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow update: if hasPermission("customer.edit")
        && (
          isSystemOwner()
          || classifiedRecordAllowed(resource.data)
        )
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow delete: if false;
    }

    match /customerNotes/{noteId} {
      allow read: if canReadCustomerRelated(resource.data.customerRecordId);

      allow create: if request.resource.data.createdBy == uid()
        && canEditCustomerRelated(request.resource.data.customerRecordId);

      allow update, delete: if false;
    }

    match /customerInteractions/{interactionId} {
      allow read: if canReadCustomerRelated(resource.data.customerRecordId);

      allow create: if request.resource.data.createdBy == uid()
        && canEditCustomerRelated(request.resource.data.customerRecordId);

      allow update, delete: if false;
    }

    match /customerFlags/{flagId} {
      allow read: if canReadCustomerRelated(resource.data.customerRecordId);

      allow create: if request.resource.data.createdBy == uid()
        && canEditCustomerRelated(request.resource.data.customerRecordId);

      allow update: if canEditCustomerRelated(resource.data.customerRecordId)
        && (
          hasPermission("customer.restrict")
          || hasPermission("customer.edit")
        );

      allow delete: if false;
    }

    match /cases/{caseRecordId} {
      allow read: if hasPermission("case.view");

      allow create: if hasPermission("case.create")
        && request.resource.data.createdBy == uid();

      allow update: if hasPermission("case.assign")
        || (
          hasPermission("case.create")
          && resource.data.assignedUid == uid()
        );

      allow delete: if false;
    }

    match /approvals/{approvalRecordId} {
      allow read: if hasPermission("approval.view")
        || (
          signedIn()
          && resource.data.requesterUid == uid()
        );

      allow create: if activeAccount()
        && request.resource.data.requesterUid == uid()
        && request.resource.data.status in ["Pending", "Submitted"];

      allow update: if hasPermission("approval.manage")
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if hasPermission("audit.view")
        || hasPermission("audit.export");

      allow create: if (
          isBootstrapOwner()
          && request.resource.data.actorUid == uid()
        )
        || (
          activeAccount()
          && request.resource.data.actorUid == uid()
          && request.resource.data.actorEmployeeId == profile().employeeId
          && request.resource.data.success == true
          && request.resource.data.createdAt == request.time
        );

      allow update, delete: if false;
    }

    function canUseCounter(counterId) {
      return hasPermission("system.manage")
        || isBootstrapOwner()
        || (counterId == "assets" && hasPermission("asset.manage"))
        || (counterId == "vendors" && hasPermission("vendor.manage"))
        || (counterId == "contracts" && hasPermission("contract.manage"))
        || (counterId == "projects" && hasPermission("project.manage"))
        || (counterId == "documents" && hasPermission("document.manage"))
        || (counterId == "announcements" && hasPermission("communications.manage"))
        || (counterId == "workflows" && hasPermission("workflow.manage"))
        || (counterId == "leaveRequests" && hasPermission("hr.request.leave"))
        || (counterId == "performanceReviews" && hasPermission("hr.manage"))
        || (counterId == "disciplinaryActions" && hasPermission("hr.manage"))
        || (counterId == "trainingRecords" && hasPermission("training.manage"))
        || (counterId == "serviceTickets" && hasPermission("service.create"))
        || (counterId == "purchaseRequests" && hasPermission("procurement.request"))
        || (counterId == "expenses" && hasPermission("finance.expense.create"))
        || (counterId == "invoices" && hasPermission("finance.manage"))
        || (counterId == "policies" && hasPermission("compliance.manage"))
        || (counterId == "complianceFindings" && hasPermission("compliance.manage"))
        || (counterId == "departments" && hasPermission("organization.manage"))
        || (counterId == "positions" && hasPermission("organization.manage"))
        || (counterId == "locations" && hasPermission("organization.manage"))
        || (counterId == "risks" && hasPermission("risk.manage"))
        || (counterId == "investigations" && hasPermission("investigation.manage"))
        || (counterId == "savedReports" && hasPermission("report.manage"))
        || (counterId == "workflowRuns" && hasPermission("workflow.run"))
        || (counterId == "accessRequests" && hasPermission("access.request"))
        || (counterId == "securityAlerts" && hasPermission("security.alerts.manage"));
    }

    match /counters/{counterId} {
      allow read: if canUseCounter(counterId);

      allow create: if canUseCounter(counterId)
        && request.resource.data.value == 1;

      allow update: if canUseCounter(counterId)
        && request.resource.data.value == resource.data.value + 1;

      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.recipientUid == uid();

      allow update: if signedIn()
        && resource.data.recipientUid == uid()
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read", "readAt"]);

      allow create: if hasPermanentPermission("system.manage")
        && request.resource.data.recipientUid is string;

      allow delete: if false;
    }


    // ---------------------------------------------------------------------
    // Generation 2 enterprise operations
    // Each collection is independently authorized. Citadel does not rely on
    // frontend navigation or hidden buttons for access control.
    // ---------------------------------------------------------------------

    match /leaveRequests/{recordId} {
      allow read: if hasPermission("hr.view")
        || (signedIn() && resource.data.requesterUid == uid());

      allow create: if hasPermission("hr.request.leave")
        && request.resource.data.requesterUid == uid()
        && request.resource.data.requesterEmployeeId == profile().employeeId
        && request.resource.data.status == "Pending";

      allow update: if hasPermission("hr.manage")
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmployeeId == resource.data.requesterEmployeeId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /performanceReviews/{recordId} {
      allow read: if hasPermission("hr.view");
      allow create, update: if hasPermission("hr.manage");
      allow delete: if false;
    }

    match /disciplinaryActions/{recordId} {
      allow read: if hasPermission("hr.view");
      allow create, update: if hasPermission("hr.manage");
      allow delete: if false;
    }

    match /trainingRecords/{recordId} {
      allow read: if hasPermission("training.view")
        || (
          hasPermission("training.self")
          && resource.data.employeeId == profile().employeeId
        );

      allow create, update: if hasPermission("training.manage");
      allow delete: if false;
    }

    match /serviceTickets/{recordId} {
      allow read: if hasPermission("service.view")
        || (signedIn() && resource.data.requesterUid == uid());

      allow create: if hasPermission("service.create")
        && request.resource.data.requesterUid == uid()
        && request.resource.data.requesterEmployeeId == profile().employeeId
        && request.resource.data.status == "New";

      allow update: if hasPermission("service.manage")
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmployeeId == resource.data.requesterEmployeeId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /assets/{recordId} {
      allow read: if hasPermission("asset.view");
      allow create, update: if hasPermission("asset.manage");
      allow delete: if false;
    }

    match /purchaseRequests/{recordId} {
      allow read: if hasPermission("procurement.view")
        || (signedIn() && resource.data.requesterUid == uid());

      allow create: if hasPermission("procurement.request")
        && request.resource.data.requesterUid == uid()
        && request.resource.data.requesterEmployeeId == profile().employeeId
        && request.resource.data.status == "Submitted";

      allow update: if hasPermission("procurement.manage")
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmployeeId == resource.data.requesterEmployeeId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /vendors/{recordId} {
      allow read: if hasPermission("vendor.view")
        || hasPermission("procurement.view");

      allow create, update: if hasPermission("vendor.manage");
      allow delete: if false;
    }

    match /contracts/{recordId} {
      allow read: if isSystemOwner()
        || (
          hasPermission("contract.view")
          && classifiedRecordAllowed(resource.data)
        );

      allow create: if hasPermission("contract.manage")
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow update: if hasPermission("contract.manage")
        && (
          isSystemOwner()
          || classifiedRecordAllowed(resource.data)
        )
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow delete: if false;
    }

    match /expenses/{recordId} {
      allow read: if hasPermission("finance.view")
        || (signedIn() && resource.data.requesterUid == uid());

      allow create: if hasPermission("finance.expense.create")
        && request.resource.data.requesterUid == uid()
        && request.resource.data.requesterEmployeeId == profile().employeeId
        && request.resource.data.status == "Submitted";

      allow update: if hasPermission("finance.manage")
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.requesterEmployeeId == resource.data.requesterEmployeeId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /invoices/{recordId} {
      allow read: if hasPermission("finance.view");
      allow create, update: if hasPermission("finance.manage");
      allow delete: if false;
    }

    match /projects/{recordId} {
      allow read: if hasPermission("project.view");
      allow create, update: if hasPermission("project.manage");
      allow delete: if false;
    }

    match /documents/{recordId} {
      allow read: if isSystemOwner()
        || (
          hasPermission("document.view")
          && classifiedRecordAllowed(resource.data)
        );

      allow create: if hasPermission("document.manage")
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow update: if hasPermission("document.manage")
        && (
          isSystemOwner()
          || classifiedRecordAllowed(resource.data)
        )
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow delete: if false;
    }

    match /announcements/{recordId} {
      allow read: if hasPermission("communications.view");
      allow create, update: if hasPermission("communications.manage");
      allow delete: if false;
    }

    match /policies/{recordId} {
      allow read: if hasPermission("compliance.view");
      allow create, update: if hasPermission("compliance.manage");
      allow delete: if false;
    }

    match /policyAcknowledgements/{recordId} {
      allow read: if hasPermission("compliance.view")
        || (signedIn() && resource.data.employeeUid == uid());

      allow create: if activeAccount()
        && request.resource.data.employeeUid == uid();

      allow update, delete: if false;
    }

    match /complianceFindings/{recordId} {
      allow read: if hasPermission("compliance.view");
      allow create, update: if hasPermission("compliance.manage");
      allow delete: if false;
    }

    match /risks/{recordId} {
      allow read: if hasPermission("risk.view");
      allow create, update: if hasPermission("risk.manage");
      allow delete: if false;
    }

    match /investigations/{recordId} {
      allow read: if isSystemOwner()
        || (
          hasPermission("investigation.view")
          && classifiedRecordAllowed(resource.data)
        );

      allow create: if hasPermission("investigation.manage")
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow update: if hasPermission("investigation.manage")
        && (
          isSystemOwner()
          || classifiedRecordAllowed(resource.data)
        )
        && validClassification(request.resource.data)
        && classificationAllowed(request.resource.data.classification);

      allow delete: if false;
    }

    match /workflows/{recordId} {
      allow read: if hasPermission("workflow.view")
        || hasPermission("workflow.manage")
        || hasPermission("workflow.run");

      allow create, update: if hasPermission("workflow.manage");
      allow delete: if false;
    }

    match /workflowRuns/{recordId} {
      allow read: if hasPermission("workflow.view")
        || hasPermission("workflow.manage")
        || hasPermission("workflow.run");

      allow create: if hasPermission("workflow.run")
        && request.resource.data.startedByUid == uid();

      allow update: if hasPermission("workflow.run.manage")
        || hasPermission("workflow.manage");

      allow delete: if false;
    }

    match /workflowTasks/{recordId} {
      allow read: if hasPermission("workflow.run")
        || hasPermission("workflow.manage");

      allow create: if hasPermission("workflow.run");

      allow update: if hasPermission("workflow.run.manage")
        || hasPermission("workflow.manage");

      allow delete: if false;
    }

    match /departments/{recordId} {
      allow read: if activeAccount();
      allow create, update: if hasPermission("organization.manage");
      allow delete: if false;
    }

    match /positions/{recordId} {
      allow read: if activeAccount();
      allow create, update: if hasPermission("organization.manage");
      allow delete: if false;
    }

    match /locations/{recordId} {
      allow read: if activeAccount();
      allow create, update: if hasPermission("organization.manage");
      allow delete: if false;
    }


    // ---------------------------------------------------------------------
    // Generation 3 intelligence, temporary access, reporting, and automation
    // ---------------------------------------------------------------------

    match /dashboardPreferences/{userId} {
      allow read, create, update: if signedIn()
        && userId == uid()
        && hasPermission("dashboard.customize");

      allow delete: if false;
    }

    match /savedReports/{recordId} {
      allow read: if hasPermission("report.view");

      allow create: if hasPermission("report.manage")
        && request.resource.data.ownerUid == uid()
        && request.resource.data.ownerEmployeeId == profile().employeeId;

      allow update: if hasPermission("report.manage")
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmployeeId == resource.data.ownerEmployeeId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /securityAlerts/{recordId} {
      allow read: if hasPermission("security.alerts.view");
      allow create, update: if hasPermission("security.alerts.manage");
      allow delete: if false;
    }

    match /accessRequests/{recordId} {
      allow read: if (
          signedIn()
          && resource.data.requesterUid == uid()
        )
        || (
          hasPermanentPermission("access.temporary.manage")
          && clearanceAtLeast(8)
        );

      allow create: if hasPermission("access.request")
        && request.resource.data.requesterUid == uid()
        && request.resource.data.status == "Pending";

      allow update: if hasPermanentPermission("access.temporary.manage")
        && clearanceAtLeast(8);

      allow delete: if false;
    }

    match /temporaryAccess/{userId} {
      allow read: if signedIn()
        && (
          userId == uid()
          || (
            hasPermanentPermission("access.temporary.manage")
            && clearanceAtLeast(8)
          )
        );

      allow create, update: if hasPermanentPermission("access.temporary.manage")
        && clearanceAtLeast(8)
        && request.resource.data.userId == userId
        && request.resource.data.clearanceLevel is int
        && request.resource.data.clearanceLevel >= 0
        && request.resource.data.clearanceLevel <= 9
        && request.resource.data.permissions is list
        && !request.resource.data.permissions.hasAny([
          "system.manage",
          "access.manage",
          "access.temporary.manage",
          "security.manage",
          "employee.manage",
          "organization.manage",
          "admin.organization.manage"
        ])
        && request.resource.data.expiresAt is timestamp;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
